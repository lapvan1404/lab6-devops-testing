  "item": [
    {
      "name": "GET All Students",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has success field\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.success).to.be.true;\n});\n\npm.test(\"Data is an array\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.data).to.be.an('array');\n});\n\npm.test(\"Has at least 3 students\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.data.length).to.be.at.least(3);\n});\n\npm.test(\"Response time < 200ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(200);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/students",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "students"
          ]
        }
      },
      "response": []
